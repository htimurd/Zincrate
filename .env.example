# Строка подключения к PostgreSQL (от Render Postgres, Neon.tech и т.п.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Любая случайная длинная строка — секрет для подписи cookie сессии
SESSION_SECRET=change_this_to_a_long_random_string

# Данные OAuth-клиента из Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Должен совпадать с адресом сайта + /auth/google/callback
# Локально:   http://localhost:3000/auth/google/callback
# На Render:  https://your-app.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Единственный email, у которого есть доступ к админ-панели
ADMIN_EMAIL=cu16106timur@gmail.com

# Порт (Render подставит свой собственный автоматически)
PORT=3000
